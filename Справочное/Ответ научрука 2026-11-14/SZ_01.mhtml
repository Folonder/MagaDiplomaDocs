 0px; border-top: 1px solid rgba(255, 255, 255, 0.14); border-bottom: 1px s=
olid rgba(255, 255, 255, 0.14); margin-bottom: 6px; font-family: "Roboto Mo=
no", monospace; }

.tt-desc { font-size: 0.72rem; color: var(--tooltip-sub); line-height: 1.35=
; }

