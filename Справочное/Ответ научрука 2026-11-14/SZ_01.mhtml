-direction: column; justify-content: space-between; }

.callout-badge { display: inline-block; align-self: flex-start; font-size: =
0.68rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04e=
m; background: var(--accent-orange); color: rgb(20, 20, 20); padding: 2px 7=
px; border-radius: 4px; margin-bottom: 8px; }

.callout-title { font-size: 0.9rem; font-weight: 700; color: var(--text-pri=
mary); margin-bottom: 6px; line-height: 1.3; }

.callout-text { font-size: 0.78rem; color: var(--text-secondary); line-heig=
ht: 1.45; margin-bottom: 10px; }

