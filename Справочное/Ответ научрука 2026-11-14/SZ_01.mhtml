round: var(--grid-line); }

.es-target-zone { position: absolute; top: 0px; bottom: 0px; left: 75.2%; w=
idth: 24.8%; background: var(--target-zone-bg); border-left: 1.5px dashed v=
ar(--accent-orange); pointer-events: none; display: flex; align-items: flex=
-end; justify-content: center; padding-bottom: 6px; }

.es-target-label { font-size: 0.68rem; font-weight: 500; color: var(--accen=
t-orange-dark); text-align: center; padding: 2px 6px; line-height: 1.2; bac=
kground: var(--bg-card); border: 1px solid var(--target-zone-border); borde=
r-radius: 4px; max-width: 92%; }

.es-row { position: relative; z-index: 1; display: grid; grid-template-colu=
mns: 235px 1fr; align-items: center; padding: 4.5px 0px; border-radius: 4px=
; cursor: pointer; }

.es-row:hover { background: var(--bg-hover); }

.es-row.dimmed { opacity: 0.3; }

.es-tool-info { display: flex; align-items: center; gap: 6px; padding-right=
: 10px; min-width: 0px; }

.es-rank { font-family: "Roboto Mono", monospace; font-size: 0.7rem; color:=
