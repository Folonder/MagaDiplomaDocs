.criteria-row:hover { background: var(--bg-hover); }

.criteria-row.is-k4 { background: var(--bg-card-accent); border: 1px solid =
var(--target-zone-border); margin: 2px -4px; padding: 4px 8px; }

.criteria-code { font-family: "Roboto Mono", monospace; font-size: 0.72rem;=
 font-weight: 600; color: var(--text-secondary); background: var(--bg-badge=
); padding: 1px 4px; border-radius: 3px; text-align: center; }

.criteria-row.is-k4 .criteria-code { background: var(--accent-orange); colo=
r: rgb(20, 20, 20); font-weight: 700; }

