.es-name-wrap { display: flex; flex-direction: column; min-width: 0px; }

.es-tool-name { font-size: 0.8rem; font-weight: 500; color: var(--text-prim=
ary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

.es-row.is-leader .es-tool-name { font-weight: 700; color: var(--accent-blu=
e); }

.es-group-badge { font-size: 0.65rem; color: var(--text-muted); white-space=
: nowrap; overflow: hidden; text-overflow: ellipsis; }

.es-bar-track { position: relative; height: 20px; display: flex; align-item=
s: center; width: 100%; }

.es-bar-fill { height: 14px; border-radius: 0px 3px 3px 0px; flex-shrink: 0=
; }

.es-row.is-leader .es-bar-fill { height: 16px; }

.es-score-label { font-family: "Roboto Mono", monospace; font-size: 0.76rem=
; font-weight: 600; color: var(--text-primary); margin-left: 6px; white-spa=
ce: nowrap; }

.es-row.is-leader .es-score-label { color: var(--accent-blue); font-weight:=
 700; }

.stacked-overview-bar { display: flex; height: 12px; width: 100%; border-ra=
dius: 6px; overflow: hidden; margin-bottom: 12px; border: 1px solid var(--b=
order-subtle); }

.stacked-segment { height: 100%; border-right: 1px solid var(--bg-surface);=
 }

.stacked-segment:last-child { border-right-width: medium; border-right-styl=
e: none; border-right-color: currentcolor; }

.criteria-layout { display: grid; grid-template-columns: 1.55fr 1fr; gap: 1=
4px; align-items: stretch; }

.criteria-list-card { background: var(--bg-card); border: 1px solid var(--b=
order-subtle); border-radius: 8px; padding: 10px 12px; }

.criteria-row { display: grid; grid-template-columns: 34px 185px 1fr 38px; =
